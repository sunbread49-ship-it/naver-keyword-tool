# 이 파일을 .env 로 복사한 뒤 실제 값을 채워넣으세요.
# .env 파일은 절대 GitHub에 커밋하지 마세요 (.gitignore에 이미 포함되어 있음).

# 네이버 검색광고 API (searchad.naver.com) - 검색수 + 경쟁도(compIdx)
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# NAVER API HUB (네이버클라우드플랫폼 콘솔에서 발급) - 블로그 검색으로 콘텐츠 포화도
NAVER_APIHUB_CLIENT_ID=
NAVER_APIHUB_CLIENT_SECRET=
